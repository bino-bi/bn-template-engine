{
  "name": "@bino-bi/bn-template-engine",
  "version": "0.28.14",
  "description": "Stencil Component Starter",
  "main": "dist/index.cjs.js",
  "module": "dist/custom-elements/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/custom-elements/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/bn-template-engine/bn-template-engine.esm.js",
  "files": [
    "dist/",
    "loader/"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:bino-bi/bn-template-engine.git"
  },
  "scripts": {
    "build": "stencil build --docs",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "dependencies.update": "npx npm-upgrade check",
    "publish:patch": "npm version patch && npm run-script build && npm publish",
    "publish:minor": "npm version minor && npm run-script build && npm publish",
    "publish:major": "npm version major && npm run-script build && npm publish",
    "exportdoc": "node scripts/docExporter.js ../www/docs/components/"
  },
  "devDependencies": {
    "@stencil/core": "^2.12.1",
    "@stencil/sass": "^1.5.2",
    "@stencil/store": "^1.5.0",
    "@types/jest": "27.4.0",
    "@types/puppeteer": "5.4.4",
    "fdir": "^5.1.0",
    "jest": "27.3.1",
    "jest-cli": "27.4.7",
    "npm-run-all": "^4.1.5",
    "puppeteer": "13.0.1",
    "standard-version": "^9.3.2",
    "typescript": "4.5.4"
  },
  "license": "MIT",
  "dependencies": {
    "@bino-bi/ibcs-component": "0.30.10",
    "@bino-bi/ibcs-component-interface": "0.6.7",
    "@emotion/hash": "^0.8.0",
    "@types/lodash": "^4.14.177",
    "faker": "^5.5.3",
    "lodash": "^4.17.21",
    "ramda": "^0.27.2",
    "styletron-engine-atomic": "^1.4.8"
  }
}
