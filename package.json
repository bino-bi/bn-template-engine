{
  "name": "@bino-bi/bn-template-engine",
  "version": "1.2.2",
  "description": "IBCS-compliant web components for business intelligence tables and charts",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/bn-template-engine/bn-template-engine.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": "./dist/index.cjs.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "node": "./loader/index.cjs.js",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./schemas/*": "./dist/schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "homepage": "https://github.com/bino-bi/bn-template-engine#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:bino-bi/bn-template-engine.git"
  },
  "scripts": {
    "build": "stencil build --docs && node scripts/generate-schemas.js",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "test:dist": "node --test scripts/test-dist/security.mjs scripts/test-dist/report.mjs scripts/test-dist/package.mjs",
    "test:tz": "TZ=America/New_York stencil test --spec -- .timezone.spec",
    "dependencies.update": "npx npm-upgrade check",
    "exportdoc": "node scripts/docExporter.js ../www/docs/product/components/",
    "lint": "eslint src/ && tsc --noEmit -p .",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss,css,json}\"",
    "release": "standard-version",
    "release:alpha": "standard-version --prerelease alpha",
    "release:beta": "standard-version --prerelease beta",
    "release:rc": "standard-version --prerelease rc",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stencil/core": "^4.43.2",
    "@stencil/sass": "^3.2.3",
    "@stencil/store": "^2.2.2",
    "@types/jest": "^29.5.14",
    "ajv": "^8.20.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.1",
    "puppeteer": "25.4.0",
    "standard-version": "^9.5.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@corex/deepmerge": "^4.0.43",
    "@emotion/hash": "^0.9.2",
    "@svgdotjs/svg.js": "^3.2.5",
    "@types/luxon": "^3.7.1",
    "alasql": "^4.17.0",
    "calculate-size": "^1.1.1",
    "fflate": "^0.8.2",
    "luxon": "^3.7.2",
    "nanoid": "^5.1.6"
  }
}
